# Copy this file to .env and fill in your own values:
#
#     cp .env.example .env
#
# .env is gitignored; this file is the committed template. Never put real
# credentials here.
#
# Read by data_layer/vector_db_manager/repository/vectorRepository.py, which is
# the memory layer's pgvector store. The data layer's DiskANN index is on disk
# and needs none of this.


# --- PostgreSQL / pgvector ----------------------------------------------------

# Database holding the `vectors` table. Created by hand, not by the app:
#     createdb Vectors
DB_NAME=Vectors

# Every name here is DB_-prefixed on purpose. load_dotenv() does not override a
# variable already in the environment, and the unprefixed names are ones other
# things set: every login shell exports USER, conda exports HOST as its compiler
# triplet (x86_64-conda-linux-gnu), and PaaS platforms set PORT. An unprefixed
# line is silently ignored and the connection goes somewhere unintended.
DB_USER=postgres

DB_PASSWORD=your_password_here

DB_HOST=localhost

DB_PORT=5432


# --- Before the first run -----------------------------------------------------
#
# VectorRepository issues `create extension if not exists vector`, which needs
# the pgvector extension installed on the server and a role allowed to create
# it. If that role is not a superuser, enable it once as one:
#
#     psql -d Vectors -c 'CREATE EXTENSION IF NOT EXISTS vector;'
#
# Vector width is not configurable here — it comes from
# Config.EMBEDDING_DIMENSIONS (128) in config.py.
