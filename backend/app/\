from config import Config

class ProjectManager:
    # we need both the query as string and also as the vector
    __project_db = Config.DATA_DIR / Path("project_db/project.sql")
    def __init__(self , topic_id : str , query : str):
        self.topic_id = topic_id
        self.query = query

    def __query_embedder(self) -> EmbeddedChunk:
        if self.query is None or self.query == "":
            raise EmptyQueryException()
        embedding_manager = EmbeddingManager()
        return embedding_manager.embed_text(self.query)
    def __is_project_exists(self) -> str:
        return ""
